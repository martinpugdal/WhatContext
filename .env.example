# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands instantly to a single guild during development
DISCORD_DEV_GUILD_ID=

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
# Strong model used for /catchup and /ask (slower, higher quality)
OLLAMA_MODEL=qwen2.5:7b
# Fast model used for per-message classification (defaults to OLLAMA_MODEL if unset)
OLLAMA_FAST_MODEL=qwen2.5:1.5b

# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/contextbot?schema=public

# How long the channel has to be quiet before its queued messages are sent to the worker (ms).
# Coalesces bursts of messages so Ollama only sees them after the conversation pauses.
ANALYZE_DEBOUNCE_MS=5000

# Which channels are analyzed is now stored in the database. Manage from Discord with:
#   /watch add [#channel]   /watch remove [#channel]   /watch list

# AES-256-GCM key used to encrypt per-guild LLM API tokens at rest. REQUIRED.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: rotating this key without re-encrypting existing rows will make all stored tokens unrecoverable.
CRYPTO_KEY=

# Default model used when a guild's /config api-key didn't include a model override.
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Dev-only escape hatch. When "true", guilds without an API key fall back to local Ollama.
# Leave UNSET (or "false") in production — without a key, the bot tells users to run /config api-key.
DEV_LOCAL_FALLBACK=false
