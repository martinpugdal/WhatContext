{
  "name": "contextbot",
  "version": "0.1.0",
  "description": "Discord bot that summarizes channel activity, captures decisions/tasks/questions, and answers questions about stored context.",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "nodemon -r dotenv/config --exec ts-node src/bot.ts",
    "build": "tsc",
    "start": "node -r dotenv/config dist/bot.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "commands:deploy": "ts-node -r dotenv/config src/deploy-commands.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ollama": "^0.5.11",
    "openai": "^6.34.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.2",
    "nodemon": "^3.1.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
